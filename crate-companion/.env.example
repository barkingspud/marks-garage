# Copy to .env (or keep it outside the repo and point DISCOGS_ENV_FILE at it).
# NEVER commit the real file.

# "Connect with Discogs" button: register the app once at
# https://www.discogs.com/settings/developers -> "Create an Application", then copy:
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Alternative: a personal access token from the same page -> "Generate new token".
# Used only when no account is connected with the button.
DISCOGS_TOKEN=

# Your Discogs username (optional; looked up from the token if blank)
DISCOGS_USERNAME=

# Discogs requires a unique User-Agent identifying your app
DISCOGS_USER_AGENT=CrateCompanion/0.1 +https://github.com/barkingspud/marks-garage

# Where the connected account is saved (default .cache/discogs-connection.json, git-ignored)
# DISCOGS_AUTH_FILE=

# App builds (Android, desktop) include the app registration so "Connect with Discogs"
# works without a server. Only set these when building the apps.
# VITE_DISCOGS_CONSUMER_KEY=
# VITE_DISCOGS_CONSUMER_SECRET=

# Port for the local API server
PORT=8787
