# Copy to .env (or keep it outside the repo and point DISCOGS_ENV_FILE at it).
# NEVER commit the real file.

# Personal access token: https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=

# Your Discogs username (optional — looked up from the token if blank)
DISCOGS_USERNAME=

# Discogs requires a unique User-Agent identifying your app
DISCOGS_USER_AGENT=CrateCompanion/0.1 +https://github.com/barkingspud/marks-garage

# Phase 2 (multi-user OAuth) — from "Create an application" on the same page
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Port for the local API server
PORT=8787
